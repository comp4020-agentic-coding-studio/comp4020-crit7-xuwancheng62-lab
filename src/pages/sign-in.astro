---
import Base from "../layouts/Base.astro";

const next = Astro.url.searchParams.get("next") ?? "/";
const error = Astro.url.searchParams.get("error") === "format";
const current = Astro.locals.studentId;
---

<Base title="Sign in">
  <div class="narrow">
    <header class="page-head">
      <h1>Sign in</h1>
      <p class="lede">
        Enter your Student ID. The first time, we'll ask for your study level and program, so we can show the right
        version of each course and recommend courses for your program.
      </p>
    </header>

    {
      current && (
        <p class="banner" role="status">
          You're signed in as <strong>{current}</strong>. Enter another Student ID to switch.
        </p>
      )
    }

    <form class="form-card" method="post" action="/api/session">
      <input type="hidden" name="next" value={next} />
      <div class:list={["field", { "has-error": error }]}>
        <label for="studentId">Student ID</label>
        <p class="field-hint" id="studentId-hint">A “u” followed by seven digits, e.g. u1234567.</p>
        {
          error && (
            <p class="field-error" id="studentId-error">
              That doesn't look like a Student ID. Use a “u” and seven digits, e.g. u1234567.
            </p>
          )
        }
        <input
          id="studentId"
          name="studentId"
          type="text"
          inputmode="text"
          autocomplete="username"
          autocapitalize="none"
          spellcheck="false"
          required
          pattern="[uU]?[0-9]{7}"
          aria-describedby={error ? "studentId-hint studentId-error" : "studentId-hint"}
          aria-invalid={error ? "true" : undefined}
        />
      </div>
      <button class="button primary large">Sign in</button>
    </form>

    <p class="hint">This is a simulated sign-in for the prototype. There's no password and no ANU account involved.</p>
  </div>
</Base>
