---
import Crumbs from "../../../../../components/Crumbs.astro";
import Base from "../../../../../layouts/Base.astro";
import { getCourseView, getSession, listEnrolments, MAX_COURSES_PER_SESSION } from "../../../../../lib/db";
import { isRecommended } from "../../../../../lib/programs";
import { assessmentItems, paragraphs, scheduleItems } from "../../../../../lib/format";

const student = Astro.locals.student!;
const session = getSession(Astro.params.session ?? "");
const view = session && getCourseView(session.code, Astro.params.code ?? "", student);
if (!session || !view) return new Response("Course not offered in this session", { status: 404 });

const { offering: course, eligible, alternative, equivalents } = view;
const base = `/sessions/${session.code}`;
const recommended = eligible && isRecommended(student.program, course.groupId);
const atLimit = !course.enrolled && listEnrolments(session.code, student.id).length >= MAX_COURSES_PER_SESSION;
---

<Base title={`${course.code} ${course.name}`}>
  <Crumbs items={[{ label: "Enrolment", href: "/" }, { label: session.name, href: `${base}/` }, { label: course.code }]} />

  <header class="course-head">
    <p class="code-line">
      <span class="code">{course.code}</span>
      {recommended && <span class="rec-tag">Recommended for your program</span>}
    </p>
    <h1>{course.name}</h1>
    <p class="meta">
      {course.units} units<span class="meta-sep" aria-hidden="true">·</span>
      {course.teachingMode}<span class="meta-sep" aria-hidden="true">·</span>
      {session.name}
    </p>
  </header>

  <div class="course-layout">
    <section class:list={["enrol-panel", { "is-ineligible": !eligible }]} aria-labelledby="enrol-title">
      <h2 id="enrol-title">Enrolment</h2>
      {
        eligible ? (
          <>
            <p class="ok">✓ Available at your study level</p>
            <p>
              This is the {course.career.toLowerCase()} offering of {course.groupName}. {course.eligibility}
            </p>
          </>
        ) : (
          <>
            <p class="warn">Not available for your academic career</p>
            <p>
              {course.code} is the {course.career.toLowerCase()} offering of {course.groupName}.
              {alternative ? (
                <>
                  {" "}Your program uses <strong>{alternative.code}</strong>.
                </>
              ) : (
                <> There's no {student.career.toLowerCase()} version in {session.name}.</>
              )}
            </p>
          </>
        )
      }

      {
        (eligible || alternative) && (
          <div class="actions">
            {eligible &&
              (course.enrolled ? (
                <span class="enrolled-tag">Enrolled in {session.name}</span>
              ) : atLimit ? (
                <p class="notice-limit">
                  You're already enrolled in {MAX_COURSES_PER_SESSION} courses this session, the most allowed. To take
                  this course, <a href={`${base}/`}>switch or drop one of your courses</a> first.
                </p>
              ) : (
                <a class="button primary" href={`${base}/courses/${course.code}/confirm/`}>
                  Add to {session.name}
                </a>
              ))}
            {alternative && (
              <a class="button primary" href={`${base}/courses/${alternative.code}/`}>
                View {alternative.code}
              </a>
            )}
          </div>
        )
      }

      <dl class="key-facts">
        <div><dt>Course code</dt><dd>{course.code}</dd></div>
        <div><dt>Academic career</dt><dd>{course.career}</dd></div>
        <div><dt>Units</dt><dd>{course.units}</dd></div>
        <div><dt>Teaching mode</dt><dd>{course.teachingMode}</dd></div>
        <div><dt>Session</dt><dd>{session.name}</dd></div>
      </dl>
    </section>

    <div class="course-body">
      <section aria-labelledby="about">
        <h2 id="about">About this course</h2>
        {paragraphs(course.description).map((p) => <p>{p}</p>)}
      </section>

      <section aria-labelledby="prereq">
        <h2 id="prereq">Prerequisites</h2>
        <p>{course.prerequisites}</p>
      </section>

      <section aria-labelledby="schedule">
        <h2 id="schedule">Schedule in {session.name}</h2>
        {
          scheduleItems(course.schedule).length > 0 ? (
            <table>
              <thead>
                <tr><th scope="col">Class</th><th scope="col">When</th><th scope="col">Where</th></tr>
              </thead>
              <tbody>
                {scheduleItems(course.schedule).map((s) => <tr><td>{s.kind}</td><td>{s.when}</td><td>{s.where}</td></tr>)}
              </tbody>
            </table>
          ) : (
            <p class="schedule-pending">
              Class times aren't published here yet. ANU releases the timetable in MyTimetable before the session
              starts.
            </p>
          )
        }
      </section>

      <section aria-labelledby="assessment">
        <h2 id="assessment">Assessment</h2>
        <table>
          <thead>
            <tr><th scope="col">Task</th><th scope="col" class="weight">Weight</th></tr>
          </thead>
          <tbody>
            {assessmentItems(course.assessment).map((a) => <tr><td>{a.item}</td><td class="weight">{a.weight}</td></tr>)}
          </tbody>
        </table>
      </section>

      {
        equivalents.length > 0 && (
          <section aria-labelledby="equivalent">
            <h2 id="equivalent">Equivalent offering</h2>
            <ul class="plain">
              {equivalents.map((e) => (
                <li>
                  <span class="code">{e.code}</span> — {e.career}
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </div>
  </div>
</Base>
