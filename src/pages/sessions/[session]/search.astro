---
import Crumbs from "../../../components/Crumbs.astro";
import HeadDecor from "../../../components/HeadDecor.astro";
import Base from "../../../layouts/Base.astro";
import { getSession, listEnrolments, MAX_COURSES_PER_SESSION, searchSubjects } from "../../../lib/db";

const session = getSession(Astro.params.session ?? "");
if (!session) return new Response("Session not found", { status: 404 });

const student = Astro.locals.student!;
const q = (Astro.url.searchParams.get("q") ?? "").trim();
const results = searchSubjects(session.code, q, student);
const base = `/sessions/${session.code}`;
const atLimit = listEnrolments(session.code, student.id).length >= MAX_COURSES_PER_SESSION;
---

<Base title={q ? `Search: ${q}` : "Course search"}>
  <Crumbs items={[{ label: "Enrolment", href: "/" }, { label: session.name, href: `${base}/` }, { label: "Search" }]} />

  <header class="page-head">
    <HeadDecor variant="grid" />
    <p class="eyebrow">{session.name}</p>
    <h1>Find a course</h1>
    <p class="lede">Search by name, code or topic. We'll show the version of each course that fits your program.</p>
  </header>

  <form class="search search-hero" method="get" action={`${base}/search/`}>
    <label for="q">Course name, code or topic</label>
    <div class="search-row">
      <input id="q" name="q" type="search" value={q} placeholder="e.g. algorithms" required />
      <button class="button primary large">Search</button>
    </div>
    <p class="hint">
      Try “programming”, “data” or a code like COMP6442. Not sure what to look for?
      <a href={`/courses/?session=${session.code}`}>Browse the course catalogue</a>.
    </p>
  </form>

  {
    atLimit && (
      <p class="notice-limit search-limit">
        You're enrolled in {MAX_COURSES_PER_SESSION} courses in {session.name}, the most allowed. You can browse course
        details, but you can't add another course this session.
      </p>
    )
  }

  {
    q && (
      <h2 class="results-head">
        {results.length} {results.length === 1 ? "result" : "results"} for “{q}” in {session.name}
      </h2>
    )
  }
  {
    q && results.length === 0 && (
      <p class="empty">No courses in {session.name} match “{q}”. Try a broader word, like “programming” or “data”.</p>
    )
  }

  {
    results.length > 0 && (
      <ul class="results">
        {results.map(({ eligible, ineligible, recommended }) => (
          <>
            {eligible && (
              <li class="result">
                <div>
                  <p class="code-line">
                    <span class="code">{eligible.code}</span>
                    {recommended && <span class="rec-tag">Recommended for your program</span>}
                  </p>
                  <h3>
                    <a href={`${base}/courses/${eligible.code}/`}>{eligible.name}</a>
                  </h3>
                  <p class="meta">
                    {eligible.units} units<span class="meta-sep" aria-hidden="true">·</span>
                    {eligible.teachingMode}<span class="meta-sep" aria-hidden="true">·</span>
                    {eligible.career}
                  </p>
                  <p class="result-summary">{eligible.summary}</p>
                  <p class="ok">✓ Available at your study level</p>
                </div>
                <div class="result-action">
                  {eligible.enrolled || atLimit ? (
                    <>
                      {eligible.enrolled && <span class="enrolled-tag">Enrolled</span>}
                      <a class="button quiet" href={`${base}/courses/${eligible.code}/`}>
                        View details<span class="visually-hidden"> for {eligible.code}</span>
                      </a>
                    </>
                  ) : (
                    <a class="button primary" href={`${base}/courses/${eligible.code}/`}>
                      Review &amp; Add<span class="visually-hidden"> {eligible.code}</span>
                    </a>
                  )}
                </div>
              </li>
            )}
            {ineligible && (
              <li class="result unavailable">
                <div>
                  <p class="code">{ineligible.code}</p>
                  <h3>
                    <a href={`${base}/courses/${ineligible.code}/`}>{ineligible.name}</a>
                  </h3>
                  <p class="warn">Not available for your academic career ({ineligible.career.toLowerCase()} offering).</p>
                  {eligible ? (
                    <p>
                      Your program uses <strong>{eligible.code}</strong>.{" "}
                      <a href={`${base}/courses/${eligible.code}/`}>View {eligible.code}</a>
                    </p>
                  ) : (
                    <p>There's no {student.career.toLowerCase()} version of this course in {session.name}.</p>
                  )}
                </div>
              </li>
            )}
          </>
        ))}
      </ul>
    )
  }
</Base>
