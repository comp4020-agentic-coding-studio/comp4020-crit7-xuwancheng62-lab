---
import Base from "../layouts/Base.astro";
import { featuredSession, listEnrolments, listSessions, statusOf } from "../lib/db";
import { formatDate, totalUnits } from "../lib/format";

const all = listSessions();
const featured = featuredSession(all);
---

<Base title="Enrolment home">
  <h1>Enrolment</h1>
  <p class="lede">Choose a session to see your enrolment and add courses. Sessions are listed in date order.</p>

  <ol class="sessions">
    {
      all.map((session) => {
        const status = statusOf(session);
        const isFeatured = session.code === featured?.code;
        const units = isFeatured ? totalUnits(listEnrolments(session.code)) : 0;
        return (
          <li class:list={["session", `status-${status.toLowerCase()}`, { featured: isFeatured }]}>
            <div class="session-main">
              <span class:list={["badge", `badge-${status.toLowerCase()}`]}>{status}</span>
              <h2>{session.name}</h2>
              <p class="dates">
                {formatDate(session.startDate)} – {formatDate(session.endDate)}
              </p>
              {isFeatured && (
                <p class="units">
                  <strong>{units}</strong> units enrolled
                </p>
              )}
            </div>
            <a
              class:list={["button", { primary: isFeatured, quiet: !isFeatured }]}
              href={`/sessions/${session.code}/`}
            >
              {isFeatured ? "Go to enrolment" : "View"}
              <span class="visually-hidden"> for {session.name}</span>
            </a>
          </li>
        );
      })
    }
  </ol>
</Base>
