---
// Refreshes the page when the signed-in student's enrolments change in
// another tab. With a session, only changes to that session count.
interface Props {
  session?: string;
}
const { session } = Astro.props;
---

<div data-live-enrolments data-session={session} hidden></div>

<script>
  const marker = document.querySelector<HTMLElement>("[data-live-enrolments]");
  if (marker && "EventSource" in window) {
    const session = marker.dataset.session;
    const source = new EventSource("/api/events");
    source.addEventListener("message", (event) => {
      const change = JSON.parse(event.data) as { session: string };
      if (!session || change.session === session) {
        source.close();
        location.reload();
      }
    });
  }
</script>
