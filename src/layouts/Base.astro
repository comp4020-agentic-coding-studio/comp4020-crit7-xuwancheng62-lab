---
import { findProgram } from "../lib/programs";
import "../styles.css";

interface Props {
  title: string;
}
const { title } = Astro.props;
const { student, studentId } = Astro.locals;
const program = student && findProgram(student.program);
const path = Astro.url.pathname;
const section = path.startsWith("/readme")
  ? "about"
  : path.startsWith("/sign-in")
    ? "sign-in"
    : path.startsWith("/profile")
      ? "profile"
      : path.startsWith("/courses")
        ? "courses"
        : "enrolment";
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title} · ANU Student Services (prototype)</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="utility-bar">
        <div class="wrap utility-inner">
          {
            studentId ? (
              <>
                <p class="identity-text">
                  <span class="identity-label">Student ID</span>
                  <strong class="identity-id">{studentId}</strong>
                  {program && <span class="identity-program">{program.name}</span>}
                  {student && <span class="career-pill">{student.career}</span>}
                </p>
                <form method="post" action="/api/session">
                  <input type="hidden" name="action" value="sign-out" />
                  <button class="identity-switch">Sign out</button>
                </form>
              </>
            ) : (
              <p class="identity-text">
                Not signed in{section !== "sign-in" && (<> · <a href="/sign-in/">Sign in</a></>)}
              </p>
            )
          }
        </div>
      </div>
      <div class="wrap masthead">
        <a class="brand" href="/">
          <img class="brand-logo" src="/anu-logo.svg" alt="The Australian National University" width="170" height="60" />
        </a>
        <a class="site-title" href="/">
          Student Services <span class="site-tag">Prototype</span>
        </a>
        <nav class="site-nav" aria-label="Site">
          <ul>
            <li><a href="/" aria-current={section === "enrolment" ? "page" : undefined}>Enrolment</a></li>
            {studentId && <li><a href="/courses/" aria-current={section === "courses" ? "page" : undefined}>Courses</a></li>}
            {studentId && <li><a href="/profile/" aria-current={section === "profile" ? "page" : undefined}>Profile</a></li>}
            <li><a href="/readme/" aria-current={section === "about" ? "page" : undefined}>About</a></li>
          </ul>
        </nav>
      </div>
    </header>
    <main id="main" class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <p class="wrap">
        A student coursework prototype, not an official ANU service. Sign-in is simulated and course information is
        illustrative.
      </p>
    </footer>
  </body>
</html>
